{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "mainBinaryName": "dsh-desktop",
  "version": "0.1.0",
  "identifier": "com.dshextra.dsh-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    },
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"]
  }
}
