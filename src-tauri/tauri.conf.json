{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH-Desktop",
  "mainBinaryName": "dsh-desktop",
  "version": "0.1.14",
  "identifier": "com.dshextra.dsh-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    },
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyODAzMEI4RUNERTRDRDYKUldUV1RON3N1RENBb2xrMWpEWDZlU0JDYXlMWTdFa2lDaCtKTTlQWllpc2tySUt3TnVnTi9QSW0K",
      "endpoints": [
        "https://github.com/lomehong/dsh-desktop/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/lomehong/dsh-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
